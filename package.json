{
  "name": "puni-memory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev dist --d1=DB=local-puni-memory --local --ip 0.0.0.0 --port 3000 --compatibility-date=2025-01-01",
    "build": "vite build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=service12",
    "db:init:local": "wrangler d1 execute puni-memory-db --local --file=./migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 migrations apply puni-memory-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply puni-memory-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.0",
    "vite": "^6.0.5",
    "wrangler": "^3.99.0"
  }
}
